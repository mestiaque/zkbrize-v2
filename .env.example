# ZKTeco Bridge Configuration
# Copy this file to .env and edit it (npm install does this automatically)

# Server
PORT=3000
HOST=0.0.0.0

# ERP API
LARAVEL_API_URL=http://your-laravel-app.com/api
LARAVEL_API_TOKEN=your-api-token-here

# ADMS Server (newer ZKTeco devices push to this)
ADMS_PORT=7788

# ZK TCP/IP (older devices - pull mode)
ZK_DEFAULT_PORT=4370
ZK_TIMEOUT=5000

# Sync Schedule (cron format)
SYNC_SCHEDULE=*/30 * * * *
ATTENDANCE_FETCH_SCHEDULE=*/15 * * * *

# Logs
LOG_LEVEL=info

# Emergency login (optional). If set, this username/password always works as superadmin —
# useful if you lose the admin password. Leave empty in normal use.
MASTER_USERNAME=
MASTER_PASSWORD=

# Attendance rules (also in Settings) — a first punch after start + grace is "late"
WORK_START_TIME=09:00
LATE_GRACE_MINUTES=15
# Days of attendance kept in data/attendance.json (records not yet sent to the ERP are always kept)
ATTENDANCE_RETENTION_DAYS=90

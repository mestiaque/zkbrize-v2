{
  "name": "attendbridge",
  "version": "1.0.0",
  "private": true,
  "description": "Connect ZKTeco attendance devices to any ERP, HRM or payroll system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "setup": "node scripts/setup.js",
    "postinstall": "node scripts/setup.js",
    "service:install": "node scripts/service.js install",
    "service:uninstall": "node scripts/service.js uninstall",
    "service:status": "node scripts/service.js status",
    "package": "node scripts/package.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "node-cron": "^4.6.0",
    "socket.io": "^4.6.2",
    "winston": "^3.11.0",
    "zkteco-js": "^1.7.2"
  },
  "optionalDependencies": {
    "node-windows": "^1.0.0-beta.8"
  }
}
